---
import "../styles/stories.css"
import { Font } from "astro:assets"
import { siteName } from "@workspace/ui/lib/site-nav"
import SiteFooter from "../components/SiteFooter.astro"
import SiteHeader from "../components/SiteHeader.astro"

interface Props {
  readonly title: string
  readonly description: string
}

const { title, description } = Astro.props
const path = Astro.url.pathname.replace(/\/+$/, "") || "/"
---

<!doctype html>
<!-- Same shell as the Next.js layout: dark theme class, Geist / Geist Mono / Bebas Neue variables. -->
<html lang="en" class="dark font-sans antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} · ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={siteName} />
    <meta name="theme-color" content="#0c1d2e" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-display-family" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body class="flex min-h-svh flex-col bg-background">
    <SiteHeader path={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <slot name="player" />
  </body>
</html>
